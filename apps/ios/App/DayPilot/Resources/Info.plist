		<dict>
			<key>CFBundleURLName</key>
			<string>com.dekuworks.daypilot.swift</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>daypilot-swift</string>
			</array>
		</dict>
	</array>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>DAYPILOT_API_URL</key>
	<string>$(DAYPILOT_API_URL)</string>
</dict>
</plist>
