// DayPilot — Prisma schema (Phase 5)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum UserRole {
  USER
  ADMIN
  ORG_ADMIN
}

enum SubscriptionTier {
  Free
  Personal
  Business
  Enterprise
  Pro
  FoundingPro
}

enum SubscriptionStatus {
  active
  canceled
  // Billing-retry grace only when currentPeriodEnd is still in the future.
  // Apple does not set this: there is no App Store Server Notification pipeline.
  past_due
  trialing
}

enum SuggestionCategory {
  feature_idea
  improvement
  bug
  integration
  other
}

enum SuggestionStatus {
  submitted
  under_review
  planned
  building
  shipped
  closed
}

enum SuggestionMessageKind {
  founder
  admin_reply
  internal_note
  status_change
}

enum BetaReleaseStage {
  internal_testing
  founder_beta
  general_availability
}

enum FounderNoticeKind {
  founder_message
  admin_reply
  status_change
  beta_available
}

enum EventSource {
  native // DayPilot-created (manual, AI, etc.)
  google // Synced from Google Calendar
  outlook // Synced from Outlook/Microsoft
  apple // Legacy CalDAV / dormant
  apple_eventkit // EventKit (iOS device) sync
  booking // From a shared booking link
}

enum CalendarProvider {
  google
  outlook
  apple // Dormant CalDAV
  apple_eventkit
}

enum ConnectionAuthStatus {
  disconnected
  connected
  error
}

enum ConnectionCalendarStatus {
  disconnected
  permission_required
  connected
  denied
  restricted
  unavailable
  error
}

enum ConnectionSyncStatus {
  idle
  syncing
  error
}

enum EventSyncState {
  synced
  pending_create
  pending_update
  pending_delete
  conflict
  failed
}

enum EventSyncDirection {
  imported
  exported
  bidirectional
}

// --- Models ---

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  supabaseUserId  String?   @unique @map("supabase_user_id")
  passwordHash    String?   @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  avatarUrl       String?   @map("avatar_url")
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  ownedOrganizations  Organization[]
  teams               Team[]               @relation("TeamMembers")
  events              Event[]
  tasks               Task[]
  subscriptions       Subscription[]
  foundingClaims      FoundingClaim[]
  planWaitlistEntries PlanWaitlistEntry[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  calendarConnections            CalendarConnection[]
  externalCalendars              ExternalCalendar[]
  calendarSyncLogs               CalendarSyncLog[]
  founderSuggestions             FounderSuggestion[]
  founderMessages                FounderSuggestionMessage[]
  founderAttachments             FounderSuggestionAttachment[]
  founderNotices                 FounderNotice[]
  founderNotificationPreference  FounderNotificationPreference?
  devicePushTokens               DevicePushToken[]
  founderBetaOptOuts             FounderBetaOptOut[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CalendarConnection {
  id                 String                    @id @default(cuid())
  userId             String                    @map("user_id")
  providerType       CalendarProvider          @map("provider_type")
  email              String // account email or display name
  accessToken        String                    @map("access_token")
  refreshToken       String?                   @map("refresh_token")
  expiresAt          DateTime?                 @map("expires_at")
  calendarId         String?                   @map("calendar_id") // provider's primary calendar id
  syncedAt           DateTime?                 @map("synced_at")
  validatedAt        DateTime?                 @map("validated_at")
  displayName        String?                   @map("display_name")
  providerAccountId  String?                   @map("provider_account_id")
  authStatus         ConnectionAuthStatus      @default(connected) @map("auth_status")
  calendarStatus     ConnectionCalendarStatus  @default(disconnected) @map("calendar_status")
  connectionMethod   String?                   @map("connection_method") // oauth | eventkit | native
  deviceId           String                    @default("") @map("device_id")
  syncStatus         ConnectionSyncStatus      @default(idle) @map("sync_status")
  syncError          String?                   @map("sync_error")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalCalendars ExternalCalendar[]
  syncLogs          CalendarSyncLog[]

  @@unique([userId, providerType, deviceId])
  @@index([userId])
  @@map("calendar_connections")
}

model ExternalCalendar {
  id                 String           @id @default(cuid())
  userId             String           @map("user_id")
  connectionId       String           @map("connection_id")
  provider           CalendarProvider
  externalCalendarId String           @map("external_calendar_id")
  title              String
  calendarType       String?          @map("calendar_type")
  sourceName         String?          @map("source_name")
  color              String?
  isPrimary          Boolean          @default(false) @map("is_primary")
  isReadOnly         Boolean          @default(false) @map("is_read_only")
  isSelected         Boolean          @default(true) @map("is_selected")
  isVisible          Boolean          @default(true) @map("is_visible")
  deviceId           String           @default("") @map("device_id")
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events     Event[]

  @@unique([userId, provider, externalCalendarId, deviceId])
  @@index([userId])
  @@index([connectionId])
  @@map("external_calendars")
}

model CalendarSyncLog {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  connectionId   String?   @map("connection_id")
  provider       CalendarProvider
  deviceId       String?   @map("device_id")
  syncStartedAt  DateTime  @default(now()) @map("sync_started_at")
  syncFinishedAt DateTime? @map("sync_finished_at")
  status         String
  eventsCreated  Int       @default(0) @map("events_created")
  eventsUpdated  Int       @default(0) @map("events_updated")
  eventsDeleted  Int       @default(0) @map("events_deleted")
  eventsSkipped  Int       @default(0) @map("events_skipped")
  errorMessage   String?   @map("error_message")
  metadata       Json      @default("{}")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection CalendarConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectionId])
  @@map("calendar_sync_logs")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teams     Team[]
  events    Event[]
  tasks     Task[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model Team {
  id             String   @id @default(cuid())
  name           String
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      User[]       @relation("TeamMembers")
  events       Event[]

  @@map("teams")
}

model Event {
  id                 String              @id @default(cuid())
  title              String
  start              DateTime
  end                DateTime
  description        String?
  location           String?
  source             EventSource         @default(native)
  externalId         String?             @map("external_id")
  externalCalendarId String?             @map("external_calendar_id")
  calendarId         String?             @map("calendar_id") // FK to external_calendars
  allDay             Boolean             @default(false) @map("all_day")
  timezone           String?
  recurrenceRule     String?             @map("recurrence_rule")
  syncState          EventSyncState      @default(synced) @map("sync_state")
  syncDirection      EventSyncDirection? @map("sync_direction")
  sourceUpdatedAt    DateTime?           @map("source_updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  metadata           Json                @default("{}")
  userId             String              @map("user_id")
  organizationId     String?             @map("organization_id")
  teamId             String?             @map("team_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  externalCalendar ExternalCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)

  @@unique([userId, source, externalId])
  @@index([userId, start])
  @@index([calendarId])
  @@map("events")
}

model Task {
  id             String    @id @default(cuid())
  title          String
  completed      Boolean   @default(false)
  dueDate        DateTime? @map("due_date")
  userId         String    @map("user_id")
  organizationId String?   @map("organization_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String              @map("user_id")
  stripeCustomerId     String?             @unique @map("stripe_customer_id")
  stripeSubscriptionId String?             @unique @map("stripe_subscription_id")
  tier                 SubscriptionTier    @default(Free)
  status               SubscriptionStatus? @default(active)
  currentPeriodEnd     DateTime?           @map("current_period_end")
  planId               String?             @map("plan_id")
  founderNumber        Int?                @map("founder_number")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// One row per verified founding purchase. Rows are never deleted when a
/// subscription expires, so spots 01–25 are not reused.
model FoundingClaim {
  id                    String   @id @default(cuid())
  founderNumber         Int      @unique @map("founder_number")
  originalTransactionId String   @unique @map("original_transaction_id")
  latestTransactionId   String   @map("latest_transaction_id")
  userId                String?  @map("user_id")
  productId             String   @map("product_id")
  periodEnd             DateTime @map("period_end")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("founding_claims")
}

model PlanWaitlistEntry {
  id               String   @id @default(cuid())
  userId           String?  @map("user_id")
  email            String
  requestedPlan    String   @map("requested_plan")
  companyName      String?  @map("company_name")
  teamSize         String?  @map("team_size")
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  createdAt        DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([email, requestedPlan])
  @@index([requestedPlan])
  @@map("plan_waitlist")
}

/// Private founder ↔ DayPilot thread. Founder number is never stored from the client.
model FounderSuggestion {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  title             String
  description       String
  category          SuggestionCategory
  status            SuggestionStatus   @default(submitted)
  featureKey        String?            @map("feature_key")
  contentHash       String             @map("content_hash")
  founderLastReadAt DateTime?          @map("founder_last_read_at")
  ownerLastReadAt   DateTime?          @map("owner_last_read_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     FounderSuggestionMessage[]
  attachments  FounderSuggestionAttachment[]
  notices      FounderNotice[]

  @@index([userId, createdAt])
  @@index([contentHash])
  @@index([status])
  @@index([category])
  @@map("founder_suggestions")
}

model FounderSuggestionMessage {
  id           String                @id @default(cuid())
  suggestionId String                @map("suggestion_id")
  authorUserId String                @map("author_user_id")
  kind         SuggestionMessageKind
  body         String
  createdAt    DateTime              @default(now()) @map("created_at")

  suggestion FounderSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([suggestionId, createdAt])
  @@map("founder_suggestion_messages")
}

model FounderSuggestionAttachment {
  id           String   @id @default(cuid())
  suggestionId String   @map("suggestion_id")
  userId       String   @map("user_id")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  byteSize     Int      @map("byte_size")
  bytes        Bytes
  createdAt    DateTime @default(now()) @map("created_at")

  suggestion FounderSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([suggestionId])
  @@map("founder_suggestion_attachments")
}

model FounderNotice {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  kind            FounderNoticeKind
  title           String
  body            String
  suggestionId    String?           @map("suggestion_id")
  featureKey      String?           @map("feature_key")
  readAt          DateTime?         @map("read_at")
  pushSentAt      DateTime?         @map("push_sent_at")
  pushSkipReason  String?           @map("push_skip_reason")
  emailSentAt     DateTime?         @map("email_sent_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion FounderSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([suggestionId])
  @@map("founder_notices")
}

model FounderNotificationPreference {
  userId    String   @id @map("user_id")
  inApp     Boolean  @default(true) @map("in_app")
  push      Boolean  @default(true)
  email     Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("founder_notification_preferences")
}

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String
  /// fcm tokens must not be sent to APNs. apns is a raw device token.
  provider  String   @default("fcm")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_push_tokens")
}

model BetaFeature {
  key                 String           @id
  name                String
  description         String
  stage               BetaReleaseStage
  platforms           String[]
  minimumAppVersion   String?          @map("minimum_app_version")
  enabled             Boolean          @default(false)
  founderAvailableAt  DateTime?        @map("founder_available_at")
  generalAvailableAt  DateTime?        @map("general_available_at")
  planEntitlement     String           @map("plan_entitlement")
  changesScheduling   Boolean          @default(false) @map("changes_scheduling")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("beta_features")
}

model FounderBetaOptOut {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  featureKey String   @map("feature_key")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@map("founder_beta_opt_outs")
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  userId         String?  @map("user_id")
  organizationId String?  @map("organization_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
